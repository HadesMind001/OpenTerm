# OpenTerm provider API keys — all OPTIONAL.
#
# The app runs fine with zero keys: crypto realtime via Binance, stocks/ETFs
# via Yahoo, news via Google News RSS. Keys only unlock the providers noted.
#
# Usage (pick ONE):
#   1. Copy this file to .env in the repo root — the backend loads it at boot.
#   2. Export these as real environment variables.
#   3. Use the in-app Keys modal (Ctrl+K -> keys), which writes
#      ~/.config/openterm/config.json (env vars take precedence over the file).
#
# NEVER commit your real .env. It is gitignored for a reason.

# Fundamentals, earnings calendar, options chain (https://finnhub.io — free tier exists)
FINNHUB_API_KEY=

# Macro series: CPI, fed funds, unemployment, yields (https://fred.stlouisfed.org/docs/api/fred/)
FRED_API_KEY=

# FX practice streaming (https://developer.oanda.com — REST API + practice account)
OANDA_TOKEN=
OANDA…_ID=

# Deep equity history / aggregates (https://polygon.io)
POLYGON_API_KEY=

# Paper/live equity brokerage (https://alpaca.markets — paper keys recommended)
APCA_API_KEY_ID=
APCA_A…KEY=
