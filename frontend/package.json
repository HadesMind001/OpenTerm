{
  "name": "openterm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fzstd": "^0.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "valtio": "^2.3.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.openterm.app",
    "productName": "OpenTerm",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "app": "dist"
    },
    "win": {
      "target": "exe"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
